from abc import ABC, abstractmethod  # Herramientas para crear clases abstractas
from datetime import datetime  # Para saber la fecha y hora de los errores

# -------------------------
# 1. ERRORES CREADOS POR MI
# -------------------------
class ErrorBase(Exception):  # El error principal del que salen los demas
    pass 

class ErrorDatoMalo(ErrorBase):  # Para cuando escriben algo mal o lo dejan vacio
    pass 

class ErrorReserva(ErrorBase):  # Para cuando algo falla cobrando o cancelando
    pass 

# --------------------------------------
# 2. ARCHIVO PARA GUARDAR ERRORES (LOGS)
# --------------------------------------
def guardar_error(mensaje):  # Funcion que guarda lo que pasa en un archivo
    try:  # Intenta abrir el archivo para escribir
        archivo = open("software_fj.log", "a", encoding="utf-8")  
        fecha = datetime.now().strftime("%Y-%m-%d %H:%M:%S")  # Saca la fecha y hora
        archivo.write(f"[{fecha}] {mensaje}\n")  # Guarda la fecha y el mensaje
    except Exception:  # Si no puede abrir el archivo por algo
        print("Aviso: No se pudo guardar el error en el archivo.")
    finally:  # Siempre se ejecuta al final para cerrar el archivo
        try: 
            archivo.close()  # Cierra el archivo
        except: 
            pass  # Si no estaba abierto, no hace nada

# -----------------------
# 3. CLASES PADRE E HIJAS
# -----------------------
class Entidad(ABC):  # Clase abstracta principal
    @abstractmethod  # Obliga a las hijas a tener esta funcion
    def ver_datos(self):  
        pass

class Cliente(Entidad):  # Clase para crear clientes
    def __init__(self, nombre, correo, telefono):  
        # Valida que los datos no esten vacios y tengan sentido
        if not nombre or "@" not in correo or not telefono.isdigit():
            raise ErrorDatoMalo("Faltan datos, el correo no tiene @ o el telefono tiene letras.")
        self.__nombre = nombre  # Variables privadas (encapsulamiento)
        self.__correo = correo
        self.__telefono = telefono
        guardar_error(f"Cliente creado: {self.__nombre}")  # Guarda que se creo bien

    def ver_datos(self):  # Muestra los datos del cliente
        return f"Cliente: {self.__nombre} | Correo: {self.__correo} | Tel: {self.__telefono}"

class Servicio(Entidad):  # Clase abstracta para los servicios
    def __init__(self, nombre, precio_base):
        if precio_base <= 0:  # El precio no puede ser negativo o cero
            raise ErrorDatoMalo("El precio del servicio debe ser mayor a cero.")
        self.nombre = nombre
        self.precio_base = precio_base

    @abstractmethod  # Obliga a las hijas a calcular el costo a su manera
    def calcular_total(self, cantidad, descuento=0.0):  # Con parametro de descuento opcional
        pass
        
    def ver_datos(self):  # Muestra los datos del servicio
        return f"Servicio: {self.nombre} | Precio: ${self.precio_base}"

class Sala(Servicio):  # Servicio 1: Prestar salas
    def __init__(self, nombre, precio_base, capacidad):
        super().__init__(nombre, precio_base)  # Le pasa el nombre y precio al padre
        if capacidad <= 0:
            raise ErrorDatoMalo("La sala debe caber por lo menos 1 persona.")
        self.capacidad = capacidad

    def calcular_total(self, horas, descuento=0.0):  # Calcula el cobro por horas
        if horas <= 0: 
            raise ErrorDatoMalo("Las horas de la sala no pueden ser negativas o cero.")
        total = (self.precio_base * horas) - (self.precio_base * horas * descuento)  
        return total

    def ver_datos(self):  # Muestra datos de la sala
        return f"Sala: {self.nombre} para {self.capacidad} personas | ${self.precio_base} por hora"

class Equipo(Servicio):  # Servicio 2: Prestar equipos (CORREGIDO EL NOMBRE AQUI)
    def __init__(self, nombre, precio_base, computadores):
        super().__init__(nombre, precio_base)  # Le pasa datos al padre
        if computadores <= 0:
            raise ErrorDatoMalo("Debe alquilar por lo menos 1 computador.")
        self.computadores = computadores

    def calcular_total(self, dias, descuento=0.0):  # Calcula cobro por dias y cantidad
        if dias <= 0: 
            raise ErrorDatoMalo("Los dias de alquiler no pueden ser cero o negativos.")
        total = (self.precio_base * self.computadores * dias) - (self.precio_base * self.computadores * dias * descuento)
        return total

    def ver_datos(self):  # Muestra datos del equipo
        return f"Alquiler: {self.computadores} {self.nombre} | ${self.precio_base} por dia c/u"

class Asesoria(Servicio):  # Servicio 3: Dar asesorias
    def __init__(self, nombre, precio_base, experto):
        super().__init__(nombre, precio_base)  # Pasa datos al padre
        if not experto:
            raise ErrorDatoMalo("La asesoria debe tener un experto asignado.")
        self.experto = experto

    def calcular_total(self, horas, descuento=0.0):  # Calcula cobro por horas
        if horas <= 0: 
            raise ErrorDatoMalo("Las horas de asesoria no pueden ser cero.")
        total = (self.precio_base * horas) - (self.precio_base * horas * descuento)
        return total

    def ver_datos(self):  # Muestra datos de asesoria
        return f"Asesoria: {self.nombre} con {self.experto} | ${self.precio_base} por hora"

# ==========================================
# 4. RESERVAS Y EXCEPCIONES
# ==========================================
class Reserva(Entidad):  # Maneja los cobros y estados
    def __init__(self, numero, cliente, servicio, tiempo):
        self.numero = numero  # Un numero normal para identificar la reserva
        self.cliente = cliente  
        self.servicio = servicio
        self.tiempo = tiempo
        self.estado = "Sin confirmar"  # Empieza sin confirmar
        self.total = 0

    def cobrar(self, descuento=0.0):  # Trata de calcular cuanto vale
        try:  # Intenta hacer la multiplicacion en el servicio
            self.total = self.servicio.calcular_total(self.tiempo, descuento)
        except Exception as e:  # Si algo falla (ENCADENAMIENTO DE ERRORES)
            guardar_error(f"Fallo el cobro en reserva {self.numero}: {e}")
            raise ErrorReserva(f"No se pudo cobrar la reserva {self.numero}") from e 
        else:  # Si todo salio perfecto sin errores (TRY/EXCEPT/ELSE)
            self.estado = "Confirmada"
            guardar_error(f"Reserva {self.numero} cobrada bien por ${self.total}")
        finally:  # Siempre se ejecuta, haya error o no (TRY/EXCEPT/FINALLY)
            guardar_error(f"Termino el intento de cobro de la reserva {self.numero}")

    def cancelar(self):  # Cancela la reserva si no estaba cancelada ya
        if self.estado == "Cancelada":
            raise ErrorReserva(f"La reserva {self.numero} ya estaba cancelada de antes.")
        self.estado = "Cancelada"
        guardar_error(f"Reserva {self.numero} cancelada.")

    def ver_datos(self):  # Muestra resumen de la reserva
        return f"Reserva {self.numero} ({self.estado}) | Para: {self.cliente._Cliente__nombre} | Total: ${self.total}"

