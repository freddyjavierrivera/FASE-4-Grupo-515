class Servicio(Entidad):  # Clase abstracta para los servicios
    def __init__(self, nombre, precio_base):
        if precio_base <= 0:  # El precio no puede ser cero o negativo
            raise ErrorDatoMalo("El precio del servicio debe ser mayor a cero.")
        self.nombre = nombre
        self.precio_base = precio_base

    @abstractmethod  # Obliga a las hijas a calcular el costo a su manera
    def calcular_total(self, cantidad, descuento=0.0):  # Con parametro opcional
        pass
        
    def ver_datos(self):  # Muestra los datos del servicio
        return f"Servicio: {self.nombre} | Precio: ${self.precio_base}"

class Sala(Servicio):  # Servicio 1: Prestar salas
    def __init__(self, nombre, precio_base, capacidad):
        super().__init__(nombre, precio_base)  # Le pasa el nombre y precio al padre
        if capacidad <= 0:
            raise ErrorDatoMalo("La sala debe caber por lo menos 1 persona.")
        self.capacidad = capacidad

    def calcular_total(self, horas, descuento=0.0):  # Calcula el cobro por horas
        if horas <= 0: 
            raise ErrorDatoMalo("Las horas de la sala no pueden ser negativas o cero.")
        return (self.precio_base * horas) - (self.precio_base * horas * descuento)  

    def ver_datos(self):  # Muestra datos de la sala
        return f"Sala: {self.nombre} para {self.capacidad} personas | ${self.precio_base}/h"

class Equipo(Servicio):  # Servicio 2: Prestar equipos 
    def __init__(self, nombre, precio_base, computadores):
        super().__init__(nombre, precio_base)  
        if computadores <= 0:
            raise ErrorDatoMalo("Debe alquilar por lo menos 1 computador.")
        self.computadores = computadores

    def calcular_total(self, dias, descuento=0.0):  # Calcula cobro por dias
        if dias <= 0: 
            raise ErrorDatoMalo("Los dias de alquiler deben ser mayores a cero.")
        return (self.precio_base * self.computadores * dias) - (self.precio_base * self.computadores * dias * descuento)

    def ver_datos(self):  # Muestra datos del equipo
        return f"Alquiler: {self.computadores} {self.nombre} | ${self.precio_base}/dia c/u"

class Asesoria(Servicio):  # Servicio 3: Dar asesorias
    def __init__(self, nombre, precio_base, experto):
        super().__init__(nombre, precio_base)  
        if not experto:
            raise ErrorDatoMalo("La asesoria debe tener un experto asignado.")
        self.experto = experto

    def calcular_total(self, horas, descuento=0.0):  # Calcula cobro por horas
        if horas <= 0: 
            raise ErrorDatoMalo("Las horas de asesoria no pueden ser cero.")
        return (self.precio_base * horas) - (self.precio_base * horas * descuento)

    def ver_datos(self):  # Muestra datos de asesoria
        return f"Asesoria: {self.nombre} con {self.experto} | ${self.precio_base}/h"

